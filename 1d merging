#include <stdio.h>

int main() {
    int arr1[100],n;
    int arr2[100],m;
    int arr3[100];
    printf("Enter the number of elements in first array:");
    scanf("%d",&n);
    printf("Enter the elements in first array:");
    for(int i=0;i<n;i++){
        scanf("%d",&arr1[i]);
    }
    printf("Enter the number of elements in second array:");
    scanf("%d",&m);
    printf("Enter the elements in second array:");
    for(int i=0;i<m;i++){
        scanf("%d",&arr2[i]);
    }
    for(int i=0;i<n;i++){
        arr3[i]=arr1[i];
    }
    for(int i=0;i<m;i++){
        arr3[n+i]=arr2[i];
    }
    printf("Merged array:");
    for(int i=0;i<n+m;i++){
        printf("%d ",arr3[i]);
    }
    return 0;
}
