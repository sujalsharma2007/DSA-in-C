#include <stdio.h>

int main() {
    int rows,cols,i,j;
    int A[100][100];
    int B[100][100];
    int sum[100][100];
    printf("Enter number of rows:");
    scanf("%d",&rows);
    printf("Enter number of columns:");
    scanf("%d",&cols);
    printf("Enter the number of elements in 1st matrix:");
    for(i=0;i<rows;i++){
        for(j=0;j<cols;j++){
            scanf("%d",&A[i][j]);
        }
    }
    printf("Enter the number of elements in 2nd matrix:");
    for(i=0;i<rows;i++){
        for(j=0;j<cols;j++){
            scanf("%d",&B[i][j]);
        }
    }
    for(i=0;i<rows;i++){
        for(j=0;j<cols;j++){
            sum[i][j]=A[i][j]+B[i][j];
        }
    }
    printf("After Addition:");
    for(i=0;i<rows;i++){
        for(j=0;j<cols;j++){
            printf("%d ",sum[i][j]);
        }
        printf("\n");
    }
    return 0;
}
