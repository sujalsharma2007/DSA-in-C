#include <stdio.h>
int toSearch(int arr[],int n,int target){
        for(int i=0;i<n;i++){
            if(arr[i]==target){
                return i;
        }
    }
        return -1;
    }

void main() {
    int n,target;
    int arr[100];
    printf("Enter the number of elements you want to insert:");
    scanf("%d",&n);
    printf("Enter the elements:");
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
    printf("Enter the value you want to search:");
    scanf("%d",&target);
    int ans=toSearch(arr,n,target);
    if(ans==-1){
        printf("Number is not found!");
    }
    else{
        printf("Number is found!");
    }
}
