#include <stdio.h>
void insertionSort(int arr[],int n){
    for(int i=1;i<n;i++){
        int key = arr[i];
        int j= i-1;
        while(arr[j]>=key && j>=0){
            arr[j+1]=arr[j];
            j--;
        }
        arr[j+1]=key;
    }
}
int main() {
    int arr[100];
    int n;
    printf("Enter number of elements:");
    scanf("%d",&n);
    printf("Enter the %d numbers:");
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
    insertionSort(arr,n);
    printf("After Sorting:");
    for(int i=0;i<n;i++){
        printf("%d ",arr[i]);
    }
    return 0;
}
