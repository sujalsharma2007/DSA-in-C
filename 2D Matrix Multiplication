#include <stdio.h>

int main() {
    int row1,col1,row2,col2,i,j;
    int A[100][100];
    int B[100][100];
    int mul[100][100];
    printf("Enter number of row1:");
    scanf("%d",&row1);
    printf("Enter number of column1:");
    scanf("%d",&col1);
    printf("Enter the number of elements in 1st matrix:");
    for(i=0;i<row1;i++){
        for(j=0;j<col1;j++){
            scanf("%d",&A[i][j]);
        }
    }
    printf("Enter number of row2:");
    scanf("%d",&row2);
    printf("Enter number of column2:");
    scanf("%d",&col2);
    printf("Enter the number of elements in 2nd matrix:");
    for(i=0;i<row2;i++){
        for(j=0;j<col2;j++){
            scanf("%d",&B[i][j]);
        }
    }
    if(col1!=row2){
        printf("Multiplication is not possible!");
    }
    else{
    for(i=0;i<=row1;i++){
        for(j=0;j<=col2;j++){
            mul[i][j]=0;
            for(int k=0;k<col1;k++){
                mul[i][j]+=A[i][k]*B[k][j];
            }
        }
    }
    printf("After Multiplication:");
    for(i=0;i<row1;i++){
        for(j=0;j<col2;j++){
            printf("%d ",mul[i][j]);
        }
        printf("\n");
    }
    }
    return 0;
}
