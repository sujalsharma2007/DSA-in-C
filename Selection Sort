#include <stdio.h>
void selectionSort(int arr[],int n){
    int temp,pivot;
    for(int i=0;i<n;i++){
        int min = arr[i];
        pivot = i;
        for(int j=i+1;j<n;j++){
            if(arr[j]<min){
                min = arr[j];
                pivot = j;
            }
        }
        temp = arr[i];
        arr[i]=arr[pivot];
        arr[pivot]=temp;
    }
    printf("After Sorting:");
    for(int i=0;i<n;i++){
        printf("%d ",arr[i]);
    }
}
int main() {
    int arr[100];
    int n;
    printf("Enter the number of elements:");
    scanf("%d",&n);
    printf("Enter the elements:\n");
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
    selectionSort(arr,n);
    return 0;
}
