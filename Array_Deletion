#include <stdio.h>
int main() {

    int arr[100];
    int n,pos,i;
    printf("Enter number of elements:");
    scanf("%d",&n);
    printf("The %d elements are",n);
    for(i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
    printf("Enter the position you want to delete:");
    scanf("%d",&pos);
    for(i=pos;i<n;i++){
        arr[i]=arr[i+1];
    }
    n--;
    printf("After Deletion:");
    for(i=0;i<n;i++){
        printf("%d ",arr[i]);
    }
    return 0;
}
